# SOC-LITE custom rules - pfSense perimeter (suricata 6/7 syntax)
# sid pool: 1000001+ (do not collide with ET rules)
# these complement the ET-open category set; tune with suppress.list

# ssh brute force burst from a single source
alert tcp $EXTERNAL_NET any -> $HOME_NET 22 (msg:"SOC SSH brute force burst"; flow:to_server,established; detection_filter:track by_src, count 8, seconds 60; sid:1000001; rev:2;)

# smb touching the perimeter from outside - should never happen
alert tcp $EXTERNAL_NET any -> $HOME_NET [139,445] (msg:"SOC SMB from external network"; flow:to_server; classtype:attempted-admin; sid:1000002; rev:1;)

# icmp sweeps and host discovery
alert icmp $EXTERNAL_NET any -> $HOME_NET any (msg:"SOC ICMP sweep"; itype:8; detection_filter:track by_src, count 20, seconds 10; sid:1000003; rev:1;)

# outbound irc - classic c2 channel
alert tcp $HOME_NET any -> $EXTERNAL_NET 6667 (msg:"SOC outbound IRC possible C2"; flow:to_server; classtype:bad-unknown; sid:1000004; rev:1;)

# dns answers with oversized payloads (tunneling heuristic)
alert udp $EXTERNAL_NET 53 -> $HOME_NET any (msg:"SOC long DNS answer possible tunnel"; dsize:>180; sid:1000005; rev:1;)
